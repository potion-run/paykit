node_modules/
lib/
# The docs site keeps source under src/lib; only built package output is ignored.
!website/src/lib/
!website/src/lib/**
dist/
*.tsbuildinfo
.env
.DS_Store
.alchemy/
coverage/
.tmp/
*.tgz

# Husky's generated hooks; the hook we author is checked in.
.husky/_
!.husky/pre-commit

# Agent skills installed by pnpm. The directory itself is checked in so a
# fresh checkout has somewhere to link the approved skills into.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/.gitignore

# Shallow source mirrors (populate via ./scripts/vendor-agent-sources.sh).
# The README beside them is ours; the clones are not.
.agent_sources/github.com/
.agent-sources/
