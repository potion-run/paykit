{
  "name": "@potion.run/polar",
  "version": "0.1.0",
  "description": "Polar products, prices and webhooks for Alchemy.",
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./*": {
        "types": "./lib/*.d.ts",
        "bun": "./src/*.ts",
        "worker": "./src/*.ts",
        "default": "./lib/*.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "alchemy-test",
    "typecheck": "tsrs -b"
  },
  "dependencies": {
    "@distilled.cloud/core": "catalog:",
    "@distilled.cloud/polar": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "alchemy": "catalog:",
    "effect": "catalog:"
  }
}
