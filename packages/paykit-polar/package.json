{
  "name": "@potion.run/paykit-polar",
  "version": "0.1.0",
  "description": "Polar for paykit: a merchant of record in one call.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potion-run/paykit.git",
    "directory": "packages/paykit-polar"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "worker": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "alchemy-test",
    "typecheck": "tsrs -b"
  },
  "dependencies": {
    "@distilled.cloud/core": "catalog:",
    "@distilled.cloud/polar": "catalog:",
    "@potion.run/paykit": "workspace:*"
  },
  "devDependencies": {
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/test": "catalog:",
    "@potion.run/paykit": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@potion.run/paykit": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:"
  }
}
