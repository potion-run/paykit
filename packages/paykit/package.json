{
  "name": "@potion.run/paykit",
  "version": "0.1.0",
  "description": "Billing and entitlement for Alchemy.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/potion-run/paykit.git",
    "directory": "packages/paykit"
  },
  "files": [
    "lib",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./Admin": "./src/Admin.ts",
    "./Atom": "./src/Atom.ts",
    "./Billing": "./src/Billing/index.ts",
    "./Foldkit": "./src/Foldkit.ts",
    "./Read": "./src/Read.ts",
    "./Surfaces": "./src/Surfaces.ts",
    "./Webhooks": "./src/Webhooks.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "bun": "./src/index.ts",
        "default": "./lib/index.js"
      },
      "./Admin": {
        "types": "./lib/Admin.d.ts",
        "bun": "./src/Admin.ts",
        "default": "./lib/Admin.js"
      },
      "./Atom": {
        "types": "./lib/Atom.d.ts",
        "bun": "./src/Atom.ts",
        "default": "./lib/Atom.js"
      },
      "./Billing": {
        "types": "./lib/Billing/index.d.ts",
        "bun": "./src/Billing/index.ts",
        "default": "./lib/Billing/index.js"
      },
      "./Foldkit": {
        "types": "./lib/Foldkit.d.ts",
        "bun": "./src/Foldkit.ts",
        "default": "./lib/Foldkit.js"
      },
      "./Read": {
        "types": "./lib/Read.d.ts",
        "bun": "./src/Read.ts",
        "default": "./lib/Read.js"
      },
      "./Surfaces": {
        "types": "./lib/Surfaces.d.ts",
        "bun": "./src/Surfaces.ts",
        "default": "./lib/Surfaces.js"
      },
      "./Webhooks": {
        "types": "./lib/Webhooks.d.ts",
        "bun": "./src/Webhooks.ts",
        "default": "./lib/Webhooks.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "pnpm -r --filter \"{.}...\" run build:package",
    "build:package": "node scripts/build.ts",
    "test": "alchemy-test",
    "schema": "node scripts/schema.ts",
    "typecheck": "tsrs -b"
  },
  "dependencies": {
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/sql": "catalog:"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/test": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@alchemy.run/cloudflare": "catalog:",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "foldkit": "catalog:"
  },
  "peerDependenciesMeta": {
    "@alchemy.run/cloudflare": {
      "optional": true
    },
    "foldkit": {
      "optional": true
    }
  }
}
