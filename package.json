{
  "name": "@potion.run/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build:package",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build:package",
    "clean": "rm -rf packages/*/lib packages/*/*.tsbuildinfo tsconfig.tsbuildinfo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prepare": "husky",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "typecheck": "tsrs -b",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.14",
        "onFail": "warn"
      },
      {
        "name": "node",
        "version": "26",
        "onFail": "warn"
      }
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
