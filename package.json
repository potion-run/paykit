{
  "name": "@potion.run/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build:package",
    "build:packages": "pnpm -r --filter \"./packages/*\" run build:package",
    "build:website": "pnpm --filter @potion.run/website build",
    "check:website": "pnpm --filter @potion.run/website check && pnpm --filter @potion.run/website validate",
    "clean": "rm -rf packages/*/lib packages/*/*.tsbuildinfo tsconfig.tsbuildinfo website/dist website/.blume",
    "deploy:website": "pnpm --filter @potion.run/website deploy",
    "destroy:website": "pnpm --filter @potion.run/website destroy",
    "dev:website": "pnpm --filter @potion.run/website dev",
    "exports:check": "node scripts/check-exports.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "prepare:hooks": "husky",
    "prepare:patch": "effect-tsgo patch --oxlint --no-typescript",
    "prepare": "pnpm prepare:hooks && pnpm prepare:patch",
    "spec": "node scripts/check-spec.ts",
    "test": "pnpm -r --filter \"./packages/*\" --filter \"./examples/*\" run test",
    "typecheck": "tsrs -b",
    "validate:publish-packages": "node scripts/validate-publish-packages.ts",
    "vendor:agent-sources": "./scripts/vendor-agent-sources.sh"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@oxlint/plugins": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "husky": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tla-ts": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "runtime": [
      {
        "name": "bun",
        "version": "1.3.14",
        "onFail": "warn"
      },
      {
        "name": "node",
        "version": "26",
        "onFail": "warn"
      }
    ]
  },
  "packageManager": "pnpm@12.16.1"
}
